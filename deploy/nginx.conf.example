# Ejemplo de nginx para servir Zombie Waves desde un único dominio:
#   - el cliente (build estático de Vite) en /
#   - el servidor Colyseus (Node, puerto 2567) en /ws (HTTP de matchmaking + WebSocket)
#
# Build del cliente en la máquina de despliegue:
#   VITE_SERVER_URL=wss://juego.midominio.com/ws npm run build -w client
#   cp -r client/dist/* /var/www/zombie-waves/
#
# Con TLS (certbot) el cliente debe usar wss://; sin TLS, ws://.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name juego.midominio.com;

    root /var/www/zombie-waves;
    index index.html;

    # Cliente estático (los assets de Vite llevan hash: cache larga)
    location /assets/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Servidor de juego: matchmaking (HTTP) + WebSocket
    location /ws/ {
        proxy_pass http://127.0.0.1:2567/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;  # las partidas mantienen el socket abierto
        proxy_send_timeout 3600s;
    }
}
