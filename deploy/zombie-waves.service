# Unidad systemd para el servidor de juego (copiar a /etc/systemd/system/).
#   sudo systemctl daemon-reload && sudo systemctl enable --now zombie-waves
[Unit]
Description=Zombie Waves game server (Colyseus)
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/zombie-waves
Environment=NODE_ENV=production
Environment=PORT=2567
ExecStart=/usr/bin/npm start -w server
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
